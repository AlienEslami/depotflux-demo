# DepotFlux application mode. The start script generates a private local file
# under .demo/; do not commit real values.
DEMO_ENVIRONMENT=demo
DEMO_AUTH_MODE=api_key
DEMO_OPERATOR_API_KEY=replace_with_at_least_20_random_characters
DEMO_APPROVER_API_KEY=replace_with_a_different_random_value
DEMO_AUDITOR_API_KEY=replace_with_a_different_random_value
DEMO_ADMIN_API_KEY=replace_with_a_different_random_value

# Optional fixed service-account names recorded in durable audit evidence.
DEMO_OPERATOR_ID=depotflux-operator
DEMO_APPROVER_ID=depotflux-approver
DEMO_AUDITOR_ID=depotflux-auditor
DEMO_ADMIN_ID=depotflux-admin

# Synthetic OT credentials. These are separate from human-facing role keys.
DEMO_CONTROL_API_KEY=replace_with_a_local_control_secret
DEMO_EMERGENCY_API_KEY=replace_with_a_different_emergency_secret
DEMO_GATEWAY_API_KEY=replace_with_an_internal_gateway_secret

# SQLite is the zero-setup development default. Compose supplies PostgreSQL and
# applies Alembic migrations before API startup.
DEMO_DATABASE_URL=sqlite:///./.demo/depotflux.db
DEMO_DATABASE_PASSWORD=replace_with_a_local_database_secret
DEMO_AUTO_CREATE_SCHEMA=true
DEMO_HOST=127.0.0.1
DEMO_PORT=8000
DEMO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_OT_GATEWAY_URL=http://127.0.0.1:8081
DEMO_METRICS_ENABLED=true
DEMO_LOG_LEVEL=INFO

# Mathematical optimization controls. The container uses the open-source HiGHS
# backend by default; a local installation may choose another supported solver.
DA_SOLVER_ORDER=appsi_highs,highs
DA_SOLVER_TIME_LIMIT=60
DA_SOLVER_MIP_GAP=0.04
DA_SOLVER_TEE=false
RT_SOLVER_ORDER=appsi_highs,highs
RT_SOLVER_TIME_LIMIT=60
RT_SOLVER_MIP_GAP=0.02
RT_SOLVER_TEE=false
